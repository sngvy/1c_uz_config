&НаСервере
Функция ПрисвоитьСписок(ИДЗадачи, ИДСписка) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	autodialer.Ссылка КАК Ссылка,
	|	autodialer.name КАК name
	|ИЗ
	|	ВнешнийИсточникДанных.BITPBX.Таблица.autodialer КАК autodialer
	|ГДЕ
	|	autodialer.id = &id";
	Запрос.УстановитьПараметр("id", ИДЗадачи);
	РезультатЗапроса = Запрос.Выполнить();	
	Выборка = РезультатЗапроса.Выбрать();	
	Пока Выборка.Следующий() Цикл
		Задача = Выборка.Ссылка.ПолучитьОбъект();
		Задача.phonelist_id = ИДСписка;
		Задача.Записать();
	КонецЦикла;
КонецФункции

