
&НаКлиенте
Функция ПерехватитьУправлениеТелефонией(НеБеспокоить) Экспорт
	Ф = ПолучитьФорму("Обработка.бит_Битфон.Форма.ОсновнаяФорма");
	Если НеБеспокоить Тогда
		Для Канал = 0 По 3 Цикл
			Ф.ЗавершитьРазговор(Канал);
			Ф.ОтклонитьВходящийВызовНаКанале(Канал);
		КонецЦикла;
		Ф.ЗавершитьВсеРазговоры();
		Ф.кнПереподключить(Неопределено);
		Ф.кнНеБеспокоить(Неопределено);
	Иначе
		Для Канал = 0 По 3 Цикл
			Ф.ЗавершитьРазговор(Канал);
			Ф.ОтклонитьВходящийВызовНаКанале(Канал);
		КонецЦикла;
		Ф.ЗавершитьВсеРазговоры();
		Ф.кнПереподключить(Неопределено);
		Ф.кнОтключить(Неопределено);
	КонецЕсли;
КонецФункции

&НаСервере
Функция СтатусЗадачи(ИДЗадачи) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	autodialer.Ссылка КАК Ссылка,
	|	autodialer.name КАК name
	|ИЗ
	|	ВнешнийИсточникДанных.BITPBX.Таблица.autodialer КАК autodialer
	|ГДЕ
	|	autodialer.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка", ИДЗадачи);
	РезультатЗапроса = Запрос.Выполнить();	
	Выборка = РезультатЗапроса.Выбрать();	
	Пока Выборка.Следующий() Цикл
		Задача = Выборка.Ссылка.ПолучитьОбъект();
	КонецЦикла;
	Возврат Задача.active;
КонецФункции

&НаСервере
Функция ЗапуститьЗадачу(ИДЗадачи) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	autodialer.Ссылка КАК Ссылка,
	|	autodialer.name КАК name
	|ИЗ
	|	ВнешнийИсточникДанных.BITPBX.Таблица.autodialer КАК autodialer
	|ГДЕ
	|	autodialer.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка", ИДЗадачи);
	РезультатЗапроса = Запрос.Выполнить();	
	Выборка = РезультатЗапроса.Выбрать();	
	Пока Выборка.Следующий() Цикл
		Задача = Выборка.Ссылка.ПолучитьОбъект();
		Задача.active = 1;
		Задача.finished = 0;
		Задача.Записать();
	КонецЦикла;
КонецФункции

