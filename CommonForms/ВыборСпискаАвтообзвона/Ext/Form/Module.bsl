
&НаСервере
Процедура ПолучитьСписки()
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	autodialer_phonelists.id КАК id,
	|	autodialer_phonelists.name КАК name
	|ИЗ
	|	ВнешнийИсточникДанных.BITPBX.Таблица.autodialer_phonelists КАК autodialer_phonelists";
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		ЭтаФорма.Элементы.Список.СписокВыбора.Добавить(Строка(Выборка.id) + " - " + Выборка.name);
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ПолучитьСписки();
КонецПроцедуры

Функция ЗаписатьНаСервере(ИДЗадачи, ИДСписка)
	ТелефонияСлужебный.ПрисвоитьСписок(ИДЗадачи, ИДСписка);
КонецФункции

&НаКлиенте
Процедура Записать(Команда)
	Если ЗначениеЗаполнено(ЭтаФорма.ИДСписка) Тогда
		ПозицияДефиса = СтрНайти(ИДСписка, "-");
		Если ПозицияДефиса > 0 Тогда
			ИДСписка = СокрП(Лев(ИДСписка, ПозицияДефиса - 1));
		КонецЕсли;
		ЗаписатьНаСервере(ИДЗадачи, ИДСписка);
		ПоказатьОповещениеПользователя("БИТ.Phone",,"Задача обновлена",БиблиотекаКартинок.NC_Подсистема_бит_Телефония);
		ЭтаФорма.Закрыть();
	Иначе
		Предупреждение("Не выбран список!",,"Ошибка записи");
	КонецЕсли;
КонецПроцедуры
