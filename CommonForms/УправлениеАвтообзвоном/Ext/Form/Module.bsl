
&НаКлиенте
Процедура Запустить(Команда)
	Если ЭтаФорма.ТекущийЭлемент = ЭтаФорма.Элементы.ЗадачиНаАТС И Элементы.ЗадачиНаАТС.ТекущиеДанные <> Неопределено Тогда
		Если Элементы.ЗадачиНаАТС.ТекущиеДанные.IDСписка = 0 Тогда
			Предупреждение("Не назначен список!",,"Управление автообзвоном");
		Иначе
			Если СтатусЗадачи(Элементы.ЗадачиНаАТС.ТекущиеДанные.ID) = 0 Тогда
				Пока СтатусЗадачи(Элементы.ЗадачиНаАТС.ТекущиеДанные.ID) = 0 Цикл
					ЗапуститьЗадачу(Элементы.ЗадачиНаАТС.ТекущиеДанные.ID);
				КонецЦикла;
				ПоказатьОповещениеПользователя("БИТ.Phone",,"Задача запущена",БиблиотекаКартинок.NC_Подсистема_бит_Телефония);
			Иначе
				Предупреждение("Задача уже запущена!",,"Управление автообзвоном");
			КонецЕсли;
		КонецЕсли;
	Иначе
		Предупреждение("Не выбрана задача!",,"Управление автообзвоном");
	КонецЕсли;
КонецПроцедуры

Функция СтатусЗадачи(ИДЗадачи)
	Возврат ТелефонияСлужебный.СтатусЗадачи(ИДЗадачи);
КонецФункции

Функция ЗапуститьЗадачу(ИДЗадачи)
	ТелефонияСлужебный.ЗапуститьЗадачу(ИДЗадачи);	
КонецФункции

Функция ОстановитьЗадачу(ИДЗадачи)
	ТелефонияСлужебный.ОстановитьЗадачу(ИДЗадачи);	
КонецФункции

&НаКлиенте
Процедура Остановить(Команда)
	Если ЭтаФорма.ТекущийЭлемент = ЭтаФорма.Элементы.ЗадачиНаАТС И Элементы.ЗадачиНаАТС.ТекущиеДанные <> Неопределено Тогда
		Если Элементы.ЗадачиНаАТС.ТекущиеДанные.IDСписка = 0 Тогда
			Предупреждение("Не назначен список!",,"Управление автообзвоном");
		Иначе
			Если СтатусЗадачи(Элементы.ЗадачиНаАТС.ТекущиеДанные.ID) = 1 Тогда
				Пока СтатусЗадачи(Элементы.ЗадачиНаАТС.ТекущиеДанные.ID) = 1 Цикл
					ОстановитьЗадачу(Элементы.ЗадачиНаАТС.ТекущиеДанные.ID);
				КонецЦикла;
				ПоказатьОповещениеПользователя("БИТ.Phone",,"Задача остановлена",БиблиотекаКартинок.NC_Подсистема_бит_Телефония);
			Иначе
				Предупреждение("Задача уже остановлена!",,"Управление автообзвоном");
			КонецЕсли;
		КонецЕсли
	Иначе
		Предупреждение("Не выбрана задача!",,"Управление автообзвоном");
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ЗадачиНаАТСВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	Возврат;
КонецПроцедуры

&НаКлиенте
Процедура СпискиНаАТСВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	Возврат;
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьСписки(Команда)
	ЭтаФорма.Элементы.СпискиНаАТС.Обновить();
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьСписок(Команда)
	Если ЭтаФорма.ТекущийЭлемент = ЭтаФорма.Элементы.ЗадачиНаАТС И Элементы.ЗадачиНаАТС.ТекущиеДанные <> Неопределено Тогда
		ФормаВыбораСписка = ПолучитьФорму("ОбщаяФорма.ВыборСпискаАвтообзвона");
		ФормаВыбораСписка.ИДЗадачи = ЧисловойИДЗадачи(Элементы.ЗадачиНаАТС.ТекущиеДанные.ID);
		ФормаВыбораСписка.Открыть();
	Иначе
		Предупреждение("Не выбрана задача!",,"Управление автообзвоном");
	КонецЕсли;
КонецПроцедуры

Функция ЧисловойИДЗадачи(ИДЗадачи)
	Возврат ТелефонияСлужебный.ЧисловойИДЗадачи(ИДЗадачи);
КонецФункции




