&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ВыполнитьПоиск();
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьПоиск()
	УстановитьПоиск(ЭтаФорма.Список, ЭтаФорма.ИскомоеЗначение);
	ПодсветитьСовпадения(ЭтаФорма.Список, ЭтаФорма.ИскомоеЗначение);
КонецПроцедуры

// Отбор: строка проходит, если совпало любое поле (ИЛИ)
&НаКлиенте
Процедура УстановитьПоиск(ДинамическийСписок, Знач ИскомаяСтрока)
	ИмяГруппы = "ПоискИЛИ";
	ЭлементыОтбора = ДинамическийСписок.Отбор.Элементы;
	
	// Убираем группу от прошлого поиска
	Для Индекс = 1 По ЭлементыОтбора.Количество() Цикл
		Элемент = ЭлементыОтбора[ЭлементыОтбора.Количество() - Индекс];
		Если Элемент.Представление = ИмяГруппы Тогда
			ЭлементыОтбора.Удалить(Элемент);
		КонецЕсли;
	КонецЦикла;
	
	Если Не ЗначениеЗаполнено(ИскомаяСтрока) Тогда
		Возврат;
	КонецЕсли;
	Если ТипЗнч(ИскомаяСтрока) <> Тип("Строка") Тогда
		ИскомаяСтрока = XMLСтрока(ИскомаяСтрока);
	КонецЕсли;
	
	Группа = ЭлементыОтбора.Добавить(Тип("ГруппаЭлементовОтбораКомпоновкиДанных"));
	Группа.ТипГруппы = ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИЛИ;
	Группа.Представление = ИмяГруппы;
	Группа.РежимОтображения = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный;
	Группа.Использование = Истина;
	
	Для Каждого Пара Из ПоляПоиска() Цикл
		Условие = Группа.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		Условие.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных(Пара.Ключ);
		Условие.ВидСравнения   = ВидСравненияКомпоновкиДанных.Содержит;
		Условие.ПравоеЗначение = ИскомаяСтрока;
		Условие.Использование  = Истина;
	КонецЦикла;
КонецПроцедуры

// Подсветка: красим только ячейку, где нашлось совпадение
&НаКлиенте
Процедура ПодсветитьСовпадения(ДинамическийСписок, Знач ИскомаяСтрока)
	ИмяОформления = "ПоискПодсветка";
	ЭлементыОформления = ДинамическийСписок.УсловноеОформление.Элементы;
	
	// Убираем подсветку от прошлого поиска
	Для Индекс = 1 По ЭлементыОформления.Количество() Цикл
		Элемент = ЭлементыОформления[ЭлементыОформления.Количество() - Индекс];
		Если Элемент.Представление = ИмяОформления Тогда
			ЭлементыОформления.Удалить(Элемент);
		КонецЕсли;
	КонецЦикла;
	
	Если Не ЗначениеЗаполнено(ИскомаяСтрока) Тогда
		Возврат;
	КонецЕсли;
	Если ТипЗнч(ИскомаяСтрока) <> Тип("Строка") Тогда
		ИскомаяСтрока = XMLСтрока(ИскомаяСтрока);
	КонецЕсли;
	
	Для Каждого Пара Из ПоляПоиска() Цикл
		Элемент = ЭлементыОформления.Добавить();
		Элемент.Представление = ИмяОформления;
		Элемент.Использование = Истина;
		
		Параметр = Элемент.Оформление.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("ЦветФона"));
		Параметр.Значение = WebЦвета.СветлоЗеленый;
		Параметр.Использование = Истина;
		
		Условие = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		Условие.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных(Пара.Ключ);
		Условие.ВидСравнения   = ВидСравненияКомпоновкиДанных.Содержит;
		Условие.ПравоеЗначение = ИскомаяСтрока;
		Условие.Использование  = Истина;
		
		ОформляемоеПоле = Элемент.Поля.Элементы.Добавить();
		ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных(Пара.Значение);
		ОформляемоеПоле.Использование = Истина;
	КонецЦикла;
КонецПроцедуры

// Поле отбора -> колонка списка, в которой красим ячейку.
// Единственное место, где перечислены поля поиска.
&НаКлиенте
Функция ПоляПоиска()
	Поля = Новый Соответствие;
	Поля.Вставить("ДолговоеОбязательство.Наименование", "ДолговоеОбязательство");
	Поля.Вставить("Ответственный.Наименование",          "Ответственный");
	Поля.Вставить("Контакт",                             "Контакт");
	Поля.Вставить("Объект.Должник.Наименование",         "Объект.Должник");
	Поля.Вставить("Объект.Кредитор.Наименование",        "Объект.Кредитор");
	Поля.Вставить("Комментарий",                         "Комментарий");
	Возврат Поля;
КонецФункции